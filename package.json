{
  "name": "yestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test:performance": "tsx tests/performance/benchmark.ts",
    "format": "prettier --write apps packages tests *.ts *.js package.json tsconfig.json",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx apps/server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@shikijs/themes": "4.4.3",
    "cheerio": "1.1.2",
    "emojibase-data": "17.0.0",
    "fastify": "5.12.3",
    "fractional-indexing": "4.0.0",
    "idb-keyval": "6.3.0",
    "ipaddr.js": "2.2.0",
    "jszip": "3.10.1",
    "lucide-react": "1.43.0",
    "mermaid": "11.17.2",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
